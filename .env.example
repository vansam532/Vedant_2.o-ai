# Server
PORT=3000
NODE_ENV=development
# Use a currently enabled Gemini model for your Google AI project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional server-only key. Never expose this in VITE_ variables or frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Public frontend settings (safe to expose; RLS must protect all data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_NAME=VEDANT AI
